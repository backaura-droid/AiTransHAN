{
  "name": "claude-thinking-ko",
  "publisher": "local",
  "displayName": "Claude 사고 한글 보기",
  "description": "Claude Code 세션의 사고(thinking) 블록을 한국어로 번역해 보여주는 패널",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "main": "./out/src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "claudeThinkingKo",
          "title": "사고 번역",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "claudeThinkingKo": [
        {
          "id": "claudeThinkingKo.panel",
          "name": "사고 번역",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeThinkingKo.togglePause",
        "title": "Claude 사고 번역: 전체 일시정지/재개",
        "icon": "$(debug-pause)"
      },
      {
        "command": "claudeThinkingKo.clear",
        "title": "Claude 사고 번역: 전체 지우기",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeThinkingKo.togglePause",
          "when": "view == claudeThinkingKo.panel",
          "group": "navigation@1"
        },
        {
          "command": "claudeThinkingKo.clear",
          "when": "view == claudeThinkingKo.panel",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^3.0.0"
  }
}
